# =============================================================================
# FINDME — Unified Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- PostgreSQL Database (REQUIRED) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findme
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_AUTO_CREATE=true

# --- Google Sheets (optional — for data export only) ---
GOOGLE_SA_KEY_PATH=crawler/config/google_service_account.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# --- Email Crawler Settings ---
MAX_CONCURRENT_REQUESTS=50
MAX_CONCURRENT_PER_DOMAIN=3
HTTP_TIMEOUT=20
HTTP_FOLLOW_REDIRECTS=true
MAX_PRIORITY_PAGES=30
MAX_AGENT_PAGES=20
MAX_TOTAL_PAGES_PER_DOMAIN=10
ENABLE_PLAYWRIGHT_FALLBACK=false
MAX_RETRIES=3
RETRY_BACKOFF=2

# --- URL Finder Settings ---
MIN_UNIQUE_RESULTS=300
MAX_RETRIES_SCRAPER=2
REQUEST_DELAY=2
MIN_SCORE=1

# --- Sheet Tab Names ---
INPUT_SHEET=Input
RESULTS_SHEET=Results
SUMMARY_SHEET=Summary
